# --- Modalità offline (Ollama locale, privacy totale) ---
# OLLAMA_MODEL=minicpm-v        # consigliato per vision: 3x più veloce di gemma4, stessa qualità
# OLLAMA_TEXT_MODEL=gemma3:4b  # per fix_symbols.py: modello leggero, no thinking mode
# OLLAMA_MODEL=gemma4           # alternativa general purpose
# OLLAMA_BASE_URL=http://localhost:11434

# --- Modalità cloud (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-...
VISION_MODEL=google/gemini-2.5-flash

# Se OLLAMA_MODEL è definito ha la precedenza su OpenRouter
